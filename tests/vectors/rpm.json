{
  "scheme": "rpm",
  "description": "rpm version comparison vectors (AlmaLinux, Rocky Linux). Inputs are [epoch:]version[-release]; cmp is the sign of compare(a, b). Epoch (missing = 0) compares as an integer, then version and release with rpmvercmp (rpmio/rpmvercmp.c), as rpm.labelCompare does; an empty release sorts before any release. Each vector holds in both directions. The first block is taken from rpm's own tests/rpmvercmp.at.",
  "vectors": [
    {"a": "1.0", "b": "1.0", "cmp": 0, "note": "rpmvercmp.at"},
    {"a": "1.0", "b": "2.0", "cmp": -1, "note": "rpmvercmp.at"},
    {"a": "2.0.1", "b": "2.0", "cmp": 1, "note": "rpmvercmp.at"},
    {"a": "2.0.1a", "b": "2.0.1", "cmp": 1, "note": "rpmvercmp.at"},
    {"a": "5.5p1", "b": "5.5p2", "cmp": -1, "note": "rpmvercmp.at"},
    {"a": "5.5p10", "b": "5.5p1", "cmp": 1, "note": "rpmvercmp.at"},
    {"a": "10xyz", "b": "10.1xyz", "cmp": -1, "note": "rpmvercmp.at"},
    {"a": "xyz10", "b": "xyz10.1", "cmp": -1, "note": "rpmvercmp.at"},
    {"a": "xyz.4", "b": "8", "cmp": -1, "note": "rpmvercmp.at: numeric beats alpha"},
    {"a": "1.0aa", "b": "1.0a", "cmp": 1, "note": "rpmvercmp.at"},
    {"a": "2a", "b": "2.0", "cmp": -1, "note": "rpmvercmp.at: alpha segment is older than numeric"},
    {"a": "1.0", "b": "1.fc4", "cmp": 1, "note": "rpmvercmp.at"},
    {"a": "3.0.0_fc", "b": "3.0.0.fc", "cmp": 0, "note": "rpmvercmp.at: separators are equivalent"},
    {"a": "1++", "b": "1_", "cmp": 0, "note": "rpmvercmp.at"},
    {"a": "+1", "b": "_1", "cmp": 0, "note": "rpmvercmp.at"},
    {"a": "1.010", "b": "1.9", "cmp": 1, "note": "numeric comparison"},
    {"a": "1.05", "b": "1.5", "cmp": 0, "note": "leading zeros are ignored"},
    {"a": "1.0~rc1", "b": "1.0", "cmp": -1, "note": "rpmvercmp.at: tilde sorts first"},
    {"a": "1.0~rc1", "b": "1.0~rc2", "cmp": -1, "note": "rpmvercmp.at"},
    {"a": "1.0~rc1~git123", "b": "1.0~rc1", "cmp": -1, "note": "rpmvercmp.at"},
    {"a": "1.0^", "b": "1.0", "cmp": 1, "note": "rpmvercmp.at: caret sorts after the end"},
    {"a": "1.0^git1", "b": "1.0", "cmp": 1, "note": "rpmvercmp.at"},
    {"a": "1.0^git1", "b": "1.01", "cmp": -1, "note": "rpmvercmp.at"},
    {"a": "1.0^20160101", "b": "1.0.1", "cmp": -1, "note": "rpmvercmp.at"},
    {"a": "1.0^20160101^git1", "b": "1.0^20160101", "cmp": 1, "note": "rpmvercmp.at"},
    {"a": "1.0~rc1^git1", "b": "1.0~rc1", "cmp": 1, "note": "rpmvercmp.at"},
    {"a": "1.0^git1~pre", "b": "1.0^git1", "cmp": -1, "note": "rpmvercmp.at"},
    {"a": "1.0^git1", "b": "1.0^git2", "cmp": -1, "note": "rpmvercmp.at"},
    {"a": "1.0~rc1", "b": "1.0^git1", "cmp": -1, "note": "tilde before caret"},

    {"a": "0:8.7p1-38.el9_4.4", "b": "8.7p1-38.el9_4.1", "cmp": 1, "note": "explicit epoch 0 equals no epoch"},
    {"a": "8.7p1-38.el9", "b": "8.7p1-38.el9_4.1", "cmp": -1, "note": "EL9 GA build vs z-stream update"},
    {"a": "5.14.0-427.13.1.el9_4", "b": "5.14.0-427.40.1.el9_4", "cmp": -1, "note": "EL9 kernel z-stream"},
    {"a": "5.14.0-503.11.1.el9_5", "b": "5.14.0-427.40.1.el9_4", "cmp": 1, "note": "EL9 kernel minor release"},
    {"a": "4.18.0-553.el8_10", "b": "4.18.0-553.5.1.el8_10", "cmp": -1, "note": "EL8 kernel: alpha segment loses to numeric"},
    {"a": "1:3.0.7-27.el9", "b": "3.0.7-28.el9", "cmp": 1, "note": "epoch wins"},
    {"a": "2:1.0-1.el9", "b": "1:9.9-1.el9", "cmp": 1, "note": "higher epoch wins"},
    {"a": "2.9.13-6.el9_4", "b": "2.9.13-6.el9", "cmp": 1, "note": "z-stream suffix is newer"},
    {"a": "2.28-251.el9_5.1", "b": "2.28-251.el9_4.4", "cmp": 1, "note": "el9_5 > el9_4"},
    {"a": "0:8.7p1-47.el9_7.rocky.0.1", "b": "8.7p1-47.el9_7", "cmp": 1, "note": "Rocky rebuild suffix"},
    {"a": "8.7p1-47.el9_7.alma.1", "b": "8.7p1-47.el9_7", "cmp": 1, "note": "AlmaLinux rebuild suffix"},
    {"a": "8.7p1-47.el9_7.alma.1", "b": "8.7p1-48.el9", "cmp": -1, "note": "release number first"},
    {"a": "7.61.1-34.el8_10.2", "b": "7.61.1-34.el8", "cmp": 1, "note": "curl EL8"},
    {"a": "1:18.20.2-1.module_el9.4.0+3858+bfd7ff98", "b": "1:18.19.0-1.module_el9.3.0+3850+d0a8e1b1", "cmp": 1, "note": "modular package"},
    {"a": "1:0.1.15-2.git2d0b8a3.module+el8.4.0+557+48ba8b2f", "b": "1:0.1.15-2.git2d0b8a3.module_el8.5.0+119+9a9ec082", "cmp": -1, "note": "module+el8.4 vs module_el8.5"},
    {"a": "1.0-1", "b": "1.0", "cmp": 1, "note": "an empty release sorts first (labelCompare)"},
    {"a": "3.0.7-27.el9", "b": "3.0.7-27.el9", "cmp": 0, "note": "identical"}
  ]
}
