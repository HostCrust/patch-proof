{
  "scheme": "dpkg",
  "description": "dpkg version comparison vectors (Debian, Ubuntu). cmp is the sign of compare(a, b): -1 if a is older, 0 if equal, 1 if a is newer. Rules: dpkg verrevcmp (lib/dpkg/version.c). Each vector holds in both directions (compare(b, a) == -cmp).",
  "vectors": [
    {"a": "1.0", "b": "1.0", "cmp": 0, "note": "identical"},
    {"a": "1.0", "b": "1.1", "cmp": -1, "note": "simple numeric"},
    {"a": "1.10", "b": "1.9", "cmp": 1, "note": "numeric, not lexical"},
    {"a": "1.001", "b": "1.1", "cmp": 0, "note": "leading zeros are ignored"},
    {"a": "1.0.0", "b": "1.0", "cmp": 1, "note": "extra component is newer"},
    {"a": "1.0", "b": "1.0-0", "cmp": 0, "note": "missing revision equals revision 0"},
    {"a": "0:1.0", "b": "1.0", "cmp": 0, "note": "epoch 0 is the default"},
    {"a": "1:1.0", "b": "2.0", "cmp": 1, "note": "epoch wins over upstream"},
    {"a": "2:1.0", "b": "1:9.9", "cmp": 1, "note": "higher epoch wins"},
    {"a": "1:9.6p1-3ubuntu13.5", "b": "9.6p1-3ubuntu13.5", "cmp": 1, "note": "epoch present only on one side"},
    {"a": "1.0~rc1", "b": "1.0", "cmp": -1, "note": "tilde sorts before the end of the string"},
    {"a": "1.0~rc1-1", "b": "1.0-1", "cmp": -1, "note": "tilde pre-release in upstream"},
    {"a": "1.0~beta1", "b": "1.0~alpha1", "cmp": 1, "note": "letters after tilde compare normally"},
    {"a": "1.0~~", "b": "1.0~~a", "cmp": -1, "note": "Debian policy: ~~ < ~~a"},
    {"a": "1.0~~a", "b": "1.0~", "cmp": -1, "note": "Debian policy: ~~a < ~"},
    {"a": "1.0~", "b": "1.0", "cmp": -1, "note": "Debian policy: ~ < (end)"},
    {"a": "1.0", "b": "1.0a", "cmp": -1, "note": "Debian policy: (end) < a"},
    {"a": "1.0a", "b": "1.0+", "cmp": -1, "note": "letters sort before non-letters"},
    {"a": "1.0", "b": "1.0+", "cmp": -1, "note": "a trailing + is newer than the end of the string"},
    {"a": "1.0a", "b": "1.0b", "cmp": -1, "note": "letters by ASCII"},
    {"a": "1.0A", "b": "1.0a", "cmp": -1, "note": "upper case before lower case"},
    {"a": "1.0-1", "b": "1.0.1-1", "cmp": -1, "note": "upstream before revision"},
    {"a": "1.0-1", "b": "1.0-2", "cmp": -1, "note": "revision"},
    {"a": "1.0-10", "b": "1.0-9", "cmp": 1, "note": "numeric revision"},
    {"a": "1.2-3-4", "b": "1.2-3-5", "cmp": -1, "note": "hyphen in upstream: revision is after the last hyphen"},
    {"a": "1:9.2p1-2+deb12u3", "b": "1:9.2p1-2+deb12u2", "cmp": 1, "note": "Debian stable security update"},
    {"a": "1:9.2p1-2+deb12u1", "b": "1:9.2p1-2", "cmp": 1, "note": "+deb12u1 is newer than the original upload"},
    {"a": "2.36-9+deb12u7", "b": "2.36-9+deb12u10", "cmp": -1, "note": "deb12u7 < deb12u10 (numeric)"},
    {"a": "1.2.3-1~deb12u1", "b": "1.2.3-1", "cmp": -1, "note": "~deb12u1 backport sorts before the base version"},
    {"a": "1.2.3-1~deb12u1", "b": "1.2.3-0+deb12u1", "cmp": 1, "note": "revision 1~ beats 0+"},
    {"a": "1.2.3-1+deb11u1", "b": "1.2.3-1+deb12u1", "cmp": -1, "note": "deb11 build sorts before deb12 build"},
    {"a": "6.1.112-1", "b": "6.1.106-3", "cmp": 1, "note": "Debian kernel point release"},
    {"a": "3.0.11-1~deb12u2", "b": "3.0.15-1~deb12u1", "cmp": -1, "note": "Debian openssl stable update with new upstream"},
    {"a": "1.22.1-9+deb12u1", "b": "1.22.1-9", "cmp": 1, "note": "nginx in Debian 12"},
    {"a": "3.0.13-0ubuntu3.16", "b": "3.0.13-0ubuntu3.4", "cmp": 1, "note": "Ubuntu security update, 16 > 4"},
    {"a": "1:9.6p1-3ubuntu13.5", "b": "1:9.6p1-3ubuntu13", "cmp": 1, "note": "Ubuntu point update"},
    {"a": "2.39-0ubuntu8.3", "b": "2.39-0ubuntu8", "cmp": 1, "note": "glibc in Ubuntu 24.04"},
    {"a": "2.4.58-1ubuntu8.4", "b": "2.4.58-1ubuntu8.10", "cmp": -1, "note": "apache2, 4 < 10"},
    {"a": "1.9.15p5-3ubuntu5.24.04.1", "b": "1.9.15p5-3ubuntu5", "cmp": 1, "note": "sudo SRU suffix"},
    {"a": "1.0-1ubuntu0.24.04.1", "b": "1.0-1ubuntu0.22.04.1", "cmp": 1, "note": "ubuntu0.24.04.1 vs ubuntu0.22.04.1"},
    {"a": "1:9.18.39-0ubuntu0.24.04.9", "b": "1:9.18.39-0ubuntu0.24.04.1", "cmp": 1, "note": "bind9 security update"},
    {"a": "1.0-1ubuntu1", "b": "1.0-1", "cmp": 1, "note": "Ubuntu delta on a Debian revision"},
    {"a": "1.0-1build1", "b": "1.0-1ubuntu1", "cmp": -1, "note": "build < ubuntu (letters)"},
    {"a": "6.8.0-48.48", "b": "6.8.0-45.45", "cmp": 1, "note": "Ubuntu kernel ABI bump"},
    {"a": "6.8.0-136.136", "b": "6.8.0-149.149", "cmp": -1, "note": "Ubuntu kernel, running vs installed"},
    {"a": "6.8.0-45.45~22.04.1", "b": "6.8.0-45.45", "cmp": -1, "note": "HWE backport sorts before the original"},
    {"a": "5.15.0-1060.69~20.04.1", "b": "5.15.0-1060.69", "cmp": -1, "note": "cloud kernel backport"},
    {"a": "2.7.18-1~20.04.4+esm1", "b": "2.7.18-1~20.04.4", "cmp": 1, "note": "Ubuntu Pro (ESM) update"},
    {"a": "4.0.1really4.0.1-0ubuntu0.24.04.9", "b": "4.0.1-0ubuntu0.24.04.9", "cmp": 1, "note": "'really' versions sort after the plain upstream"},
    {"a": "20240318.git3b128b60-0ubuntu2", "b": "20240318.git3b128b60-0ubuntu2.1", "cmp": -1, "note": "date-based upstream"},
    {"a": "1:2.11-8", "b": "2.11-9", "cmp": 1, "note": "epoch beats revision"},
    {"a": "1:11.4.13+maria~ubu2404", "b": "1:10.11.13-0ubuntu0.24.04.1", "cmp": 1, "note": "third-party MariaDB build"},
    {"a": "8.2.12-1ubuntu2.1", "b": "8.2.12-1ubuntu2", "cmp": 1, "note": "php8.x security update"},
    {"a": "0", "b": "1:0", "cmp": -1, "note": "bare epoch"},
    {"a": "a", "b": "b", "cmp": -1, "note": "pure letters"},
    {"a": "1.0+dfsg-1", "b": "1.0-1", "cmp": 1, "note": "+dfsg repack sorts after the plain upstream"},
    {"a": "1.0~dfsg-1", "b": "1.0-1", "cmp": -1, "note": "~dfsg repack sorts before the plain upstream"},
    {"a": "2.0.0+git20240101.abcdef-1", "b": "2.0.0-1", "cmp": 1, "note": "snapshot after release"}
  ]
}
